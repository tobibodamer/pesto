{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pesto",
  "version": "0.1.0",
  "identifier": "dev.pesto.app",
  "build": {
    "beforeDevCommand": "pnpm dev:overlay",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Pesto",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "resizable": false,
        "visible": false,
        "width": 800,
        "height": 600
      },
      {
        "label": "ask",
        "title": "Talk to Pesto",
        "url": "ask.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "width": 380,
        "height": 76
      },
      {
        "label": "settings",
        "title": "Pesto settings",
        "url": "settings.html",
        "theme": "Light",
        "center": true,
        "visible": false,
        "width": 840,
        "height": 640,
        "minWidth": 600,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["models/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
