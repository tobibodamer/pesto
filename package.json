{
  "name": "pesto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:debug": "node dev/debug.mjs",
    "dev:web": "vite",
    "dev:overlay": "vite --port 1422 --strictPort",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build",
    "typecheck": "tsc --noEmit",
    "sheet": "node dev/shoot.mjs",
    "studio": "vite --open /dev/studio.html"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
